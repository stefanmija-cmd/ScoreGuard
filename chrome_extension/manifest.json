{
  "manifest_version": 3,
  "name": "ScoreGuard — Backoffice uvoz",
  "version": "0.1.4",
  "description": "Prenosi već prikazane fudbalske mečeve iz izabranog Backoffice taba u prijavljeni ScoreGuard panel.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScoreGuard uvoz"
  }
}
